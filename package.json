{
	"name": "sudoku",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && vite preview",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:workers": "vitest run --project workers",
		"test:coverage": "vitest run --project unit --coverage",
		"test:e2e": "playwright test",
		"deploy": "vite build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"gen:puzzles": "tsx scripts/generate-puzzles.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed:local": "wrangler d1 execute DB --local --file seeds/puzzles.sql",
		"db:seed:remote": "wrangler d1 execute DB --remote --file seeds/puzzles.sql"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.13",
		"partysocket": "^1.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "^1.63.0",
		"@cloudflare/vitest-plugin": "^1.3.7",
		"@playwright/test": "^1.64.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^4.1.11",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.148.0"
	}
}
