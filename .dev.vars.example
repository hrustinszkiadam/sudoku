# Copy to .dev.vars for local development. Never commit .dev.vars.
# Any long random string; signs the session cookie.
SESSION_SECRET=dev-only-change-me-0123456789abcdef
# Cloudflare's documented Turnstile test keys (always pass).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
