{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		// DOM for code passed to page.evaluate() in e2e tests.
		"lib": ["ES2023", "DOM"],
		"types": ["node"]
	},
	"include": ["*.config.ts", "scripts", "e2e", "src/shared", "src/**/*.test.ts"]
}
